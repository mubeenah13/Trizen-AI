# Application Configuration
APP_NAME="TrizenAI Photo Sharing Platform"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:8000"

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trizen_photos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/trizen_photos"
# Test database URL (used by pytest)
TEST_DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/trizen_photos_test"

# JWT Auth Security Configuration
JWT_SECRET_KEY="supersecretjwtkeyforphotosharingplatformchangeinproduction"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Gallery Access Token (Public Customer PIN verification)
GALLERY_JWT_SECRET_KEY="supersecretgalleryjwtkeyforcustomeraccess"
GALLERY_TOKEN_EXPIRE_MINUTES=120

# Object Storage (S3 / MinIO) Configuration
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="trizen-photos-bucket"
S3_REGION="us-east-1"
S3_USE_SSL=False

# Local Storage Fallback Mode (True for local file fallback when MinIO is not available)
STORAGE_MODE="s3"

# Security Rate Limiting / Brute-force Protection
MAX_PIN_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15
